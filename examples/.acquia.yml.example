# Acquia Cloud Configuration
# This file stores your Acquia Cloud Application ID for alias generation
#
# To find your Application ID:
# 1. Go to https://cloud.acquia.com
# 2. Select your application
# 3. Look for the UUID in the URL or application details
#
# Example format:
# cloud:
#   appId: '00000000-0000-0000-0000-000000000000'

cloud:
  appId: ''
