{
  "name": "moneeshkoundal/drush-acquia-alias-generator",
  "description": "Drush command to generate Acquia Cloud site aliases for ACE, ACP, and ACSF projects",
  "type": "drupal-drush",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Moneesh Koundal",
      "email": "moneesh.koundal@acquia.com"
    }
  ],
  "keywords": [
    "drupal",
    "drush",
    "acquia",
    "site-aliases",
    "acsf",
    "ace",
    "acp"
  ],
  "homepage": "https://github.com/moneeshkoundal/drush-acquia-alias-generator",
  "support": {
    "issues": "https://github.com/moneeshkoundal/drush-acquia-alias-generator/issues",
    "source": "https://github.com/moneeshkoundal/drush-acquia-alias-generator"
  },
  "require": {
    "php": ">=8.1",
    "drush/drush": "^11.0 || ^12.0 || ^13.0",
    "typhonius/acquia-php-sdk-v2": "^3.0 || ^4.0",
    "symfony/yaml": "^5.0 || ^6.0 || ^7.0"
  },
  "require-dev": {
    "drupal/core-dev": "^10.0 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "Drush\\Commands\\drush_acquia_alias_generator\\": "src/"
    }
  },
  "extra": {
    "drush": {
      "services": {
        "drush.services.yml": "^11 || ^12 || ^13"
      }
    }
  },
  "repositories": {
    "drush-acquia-alias-generator": {
      "type": "vcs",
      "url": "https://github.com/moneeshkoundal/drush-acquia-alias-generator"
    }
  }
}
